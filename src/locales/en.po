#: src/lib/snippets.svelte.js
msgid ""
"<button class=\"prayer-button\">\n"
"  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"\n"
"       fill=\"none\" stroke=\"currentColor\" stroke-width=\"{0}\"\n"
"       stroke-linecap=\"round\" stroke-linejoin=\"round\" overflow=\"visible\" aria-hidden=\"true\">\n"
"    <!-- … -->\n"
"  </svg>\n"
"  مواقيت الصلاة\n"
"</button>\n"
"\n"
"<style>\n"
"  /* الأيقونة تأخذ لون النص، فقاعدة واحدة تلوّنهما معاً */\n"
"  .prayer-button { color: #1f6b55; }\n"
"</style>"
msgstr ""
"<button class=\"prayer-button\">\n"
"  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"\n"
"       fill=\"none\" stroke=\"currentColor\" stroke-width=\"{0}\"\n"
"       stroke-linecap=\"round\" stroke-linejoin=\"round\" overflow=\"visible\" aria-hidden=\"true\">\n"
"    <!-- … -->\n"
"  </svg>\n"
"  Prayer times\n"
"</button>\n"
"\n"
"<style>\n"
"  /* The icon takes the text colour, so one rule colours both */\n"
"  .prayer-button { color: #1f6b55; }\n"
"</style>"

#: src/lib/snippets.svelte.js
msgid ""
"<h2 class=\"section-title\">\n"
"  <svg aria-hidden=\"true\" …>…</svg>\n"
"  المساجد القريبة\n"
"</h2>\n"
"\n"
"<style>\n"
"  .section-title { color: #a8741a; }\n"
"  /* الحجم من CSS يغلب خاصيتَي width وheight */\n"
"  .section-title svg { width: 2rem; height: 2rem; }\n"
"</style>"
msgstr ""
"<h2 class=\"section-title\">\n"
"  <svg aria-hidden=\"true\" …>…</svg>\n"
"  Nearby mosques\n"
"</h2>\n"
"\n"
"<style>\n"
"  .section-title { color: #a8741a; }\n"
"  /* A size from CSS overrides the width and height attributes */\n"
"  .section-title svg { width: 2rem; height: 2rem; }\n"
"</style>"

#: src/lib/snippets.svelte.js
msgid ""
"<!-- بجوار نص يقول المعنى: أخفِها عن قارئ الشاشة -->\n"
"<button>\n"
"  <svg aria-hidden=\"true\" …>…</svg>\n"
"  مواقيت الصلاة\n"
"</button>\n"
"\n"
"<!-- زر بلا نص: الاسم على الزر، والأيقونة مخفية -->\n"
"<button aria-label=\"اتجاه القبلة\">\n"
"  <svg aria-hidden=\"true\" …>…</svg>\n"
"</button>\n"
"\n"
"<!-- أيقونة تحمل المعنى وحدها -->\n"
"<svg role=\"img\" aria-label=\"حلال\" …>…</svg>"
msgstr ""
"<!-- Beside text that says the meaning: hide it from the screen reader -->\n"
"<button>\n"
"  <svg aria-hidden=\"true\" …>…</svg>\n"
"  Prayer times\n"
"</button>\n"
"\n"
"<!-- A button with no text: the name goes on the button, and the icon is hidden -->\n"
"<button aria-label=\"Qibla direction\">\n"
"  <svg aria-hidden=\"true\" …>…</svg>\n"
"</button>\n"
"\n"
"<!-- An icon that carries the meaning on its own -->\n"
"<svg role=\"img\" aria-label=\"Halal\" …>…</svg>"

